{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mingyangbao-website",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "mingyangbao.site", "custom_domain": true },
    { "pattern": "www.mingyangbao.site", "custom_domain": true }
  ]
}
